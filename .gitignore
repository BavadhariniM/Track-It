# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Code generation output (riverpod_generator, drift, etc.) — regenerated via
# `dart run build_runner build --delete-conflicting-outputs`, see README
*.g.dart
*.freezed.dart
*.gr.dart

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Project-specific: personal/local files that shouldn't be shared
# Claude Code's own local settings and lock file (machine-specific, not team config)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# BMad's generated run output (ephemeral working files, not application source —
# see docs/Query.txt's own "folders to ignore" note)
/_bmad/
/_bmad-output/

# Claude Code / BMad tooling config and bundled skill packs — not application source
.claude/skills/
.agents/skills/
.github/agents/

# Personal exported app data and debug screenshots dropped in for testing —
# contains real habit-tracking data, not sample/fixture data meant to ship
/App data/
tracker-export-*.json
